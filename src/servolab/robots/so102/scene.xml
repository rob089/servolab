<!-- The SO102 on a floor. Open this file to look at the robot. -->
<mujoco model="so102 scene">
  <include file="so102.xml"/>

  <visual>
    <headlight diffuse="0.45 0.45 0.45" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.96 0.97 0.98" rgb2="0.82 0.85 0.88" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.80 0.82 0.84" rgb2="0.74 0.76 0.79"
             width="300" height="300" mark="edge" markrgb="0.68 0.7 0.73"/>
    <material name="grid" texture="grid" texrepeat="12 12" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0.4 -0.4 1.5" dir="-0.25 0.25 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <geom name="floor" type="plane" size="0.6 0.6 0.01" material="grid"/>
  </worldbody>
</mujoco>
